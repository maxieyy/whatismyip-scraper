{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "routes": [
    {
      "src": "/api/lookup",
      "dest": "/api/index.py"
    },
    {
      "src": "/api/lookup/batch",
      "dest": "/api/index.py",
      "methods": ["POST"]
    },
    {
      "src": "/api/health",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
